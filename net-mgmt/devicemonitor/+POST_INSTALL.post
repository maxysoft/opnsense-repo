# The rendered configuration can hold an SMTP password, so keep it readable
# only by root and the services that run as root.
chmod 600 /var/db/devicemonitor/config.json 2>/dev/null || true

# configd was restarted and the templates rendered by the section above, which
# also wrote /etc/rc.conf.d/devicemonitor. Give configd a moment, then start.
sleep 2
/usr/local/sbin/configctl devicemonitor start || true
